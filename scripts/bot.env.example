# Configuration du bot Telegram Kaz'a Bitcoin
# Copie ce fichier en `bot.env` (qui, lui, n'est PAS versionné) et remplis-le.
#
#   cp scripts/bot.env.example scripts/bot.env

# Token donné par @BotFather (https://t.me/BotFather)
KAZA_BOT_TOKEN=123456789:AA...

# Ton identifiant Telegram (chiffres). Le bot n'obéit qu'à cet id.
# Pour le connaître : écris à @userinfobot, il te renvoie ton id.
KAZA_BOT_CHAT_ID=000000000

# Chemin absolu du dépôt cloné sur le nœud
KAZA_REPO_DIR=/home/umbrel/kaza-bitcoin

# Clé SSH de déploiement du nœud (la privée). Laisse vide si git pousse
# déjà sans clé explicite.
KAZA_GIT_SSH_KEY=/home/umbrel/.ssh/kaza_deploy
